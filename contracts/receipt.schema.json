{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TeamBrain receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "receipt_id", "project_id", "actor_id", "created_at", "summary", "sources", "privacy_review", "status"],
  "properties": {
    "schema_version": {"type":"integer","const":1},
    "receipt_id": {"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{1,127}$"},
    "project_id": {"type":"string","minLength":1}, "actor_id": {"type":"string","minLength":1},
    "created_at": {"type":"string","format":"date-time"}, "summary": {"type":"string","minLength":1,"maxLength":10000},
    "sources": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "privacy_review": {"type":"boolean"}, "status": {"enum":["pending","approved","rejected"]},
    "related_decisions": {"type":"array","items":{"type":"string"}}, "related_commits": {"type":"array","items":{"type":"string"}},
    "follow_ups": {"type":"array","items":{"type":"string"}}
  }
}
